# Server Configuration
# Railway and other cloud platforms automatically inject PORT. Defaults to 3000 locally.
PORT=3000

# Meta Webhook Verification Token
# Set this exact string in the Meta App Dashboard under Webhooks -> Instagram -> Verify Token
VERIFY_TOKEN=mehak_secret_verify_token

# Meta Graph API Page Access Token
# Must have permissions: pages_messaging, instagram_manage_messages, pages_show_list
PAGE_ACCESS_TOKEN=your_meta_page_access_token_here

# Google Gemini API Key
# Generated from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Persistent SQLite Database Path
# Set this if you attach a persistent volume on Railway (e.g., /data/chat_queue.db)
# Defaults to ./data/chat_queue.db if not provided
# DATABASE_PATH=/data/chat_queue.db
